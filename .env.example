# GuideAnts backend
GUIDEANTS_BASE_URL=http://localhost:5107
GUIDEANTS_PUB_ID=00000000-0000-0000-0000-000000000000
GUIDEANTS_API_KEY=anonymous
GUIDEANTS_MODEL=guide

# Request timeout (seconds) for calls to GuideAnts. The openai SDK's default
# (600s, 2 retries) is dead air on a live phone call, so this app uses a much
# tighter budget and a single retry.
#GUIDEANTS_TIMEOUT_SECONDS=30

# Voice receptionist behavior
WELCOME_GREETING=Thanks for calling! How can I help you today?

# Optional: validate X-Twilio-Signature on incoming requests
TWILIO_AUTH_TOKEN=

# Server
PORT=8080

# Filler phrases (optional; sensible built-in defaults if unset).
# Spoken before the real answer when the caller's utterance looks like a
# question/request, to mask GuideAnts lookup latency. Pipe-separated since
# phrases contain commas/periods.
#FILLER_PHRASES=Let me look that up for you.|One moment while I check on that.

# How long (in seconds) to wait for GuideAnts' reply before speaking a filler
# phrase, for utterances that look like a question/request. If the reply
# arrives before this elapses, no filler is spoken at all.
#FILLER_DELAY_SECONDS=1.0

# How long (in seconds) the caller must stay quiet after a transcribed
# utterance before it's committed as their turn. Lets a caller take a brief
# mid-sentence pause without the first half being answered and the second
# half ignored; a clientSpeaking speaker event during the wait holds the
# turn open for the continuation. Raising this tolerates longer pauses but
# delays the start of every reply by the same amount.
#TURN_PAUSE_SECONDS=0.5

# After the caller resumes and then stops again, how long (in seconds) to
# wait for the continuation's transcript (which trails the stop event by
# STT finalization time) before committing the buffered text alone.
#TURN_RESUME_GRACE_SECONDS=1.5

# The literal phrase the guide must speak at the start of its final answer
# (see guide-demo/Twillio demo agent/instructions.md's "FINAL ANSWER
# MARKER" paragraph). guide_client.py forwards nothing to Twilio until this
# phrase has been seen in the stream, and never speaks the phrase itself.
# Set to an empty string to disable gating (every delta streams live).
#FINAL_ANSWER_SENTINEL=declare victory

# How long (in seconds) after a client-side tool call starts to soften
# barge-in: non-stop-command caller speech is ignored instead of cancelling
# the answer that's still coming, since the guide may be silent for real
# tool-call latency, not because it finished. An explicit stop/wait phrase
# always still cuts through immediately.
#TOOL_CALL_BARGE_IN_GRACE_SECONDS=8

# Extra comma-separated phrases (beyond the built-in list) that count as pure
# acknowledgment/backchannel noise and should never get a guide reply.
#EXTRA_BACKCHANNEL_PHRASES=no worries,all good

# Extra comma-separated phrases (beyond the built-in barge_in.STOP_PHRASES)
# that, if heard while the assistant is mid-reply, cancel it.
#EXTRA_STOP_PHRASES=cancel that,forget it

# Short local acknowledgments (optional; sensible built-in defaults if unset).
# Spoken instead of a GuideAnts reply when a stop/wait phrase cancels an
# in-flight reply. Pipe-separated since phrases contain periods.
#STOP_ACK_PHRASES=Okay.|Got it.

# Assumed TTS speaking rate in words/second, used to estimate how long a
# reply takes to speak aloud. Twilio's agent-stopped speaker event is the
# primary "reply finished playing" signal; this estimate paces replies until
# the first such event is recognized on a call, and caps how long the app
# waits for one after that.
#TTS_WORDS_PER_SECOND=2.5

# --- Booqable reservation tools (Client Actions, resolved by app/guide_client.py) ---
# Never commit real keys here.
BOOQABLE_COMPANY_URL=https://smart-apps-innovations.booqable.com
BOOQABLE_API_KEY=your_booqable_api_key_here

# Timezone naive starts_at/stops_at values from the guide are interpreted in,
# before being converted to UTC for Booqable.
BOOQABLE_TIMEZONE=America/New_York

# --- Outbound SMS (the sendPaymentLink reservation tool) ---
# Never commit real credentials here. TWILIO_AUTH_TOKEN above doubles as the
# REST API auth token.
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_FROM_NUMBER=+15555550100

# Placeholder until real Stripe/Booqable payment-link generation exists (see
# docs/PAYMENT_LINK_OPTIONS.md) -- not a real checkout URL yet.
PAYMENT_LINK_BASE_URL=https://example.com/pay

# --- Outbound email (Postmark) ---
# Never commit real credentials here. POSTMARK_FROM_EMAIL must be a confirmed
# Sender Signature in your Postmark account, or sends fail with ErrorCode 401.
POSTMARK_SERVER_TOKEN=your_postmark_server_token_here
POSTMARK_FROM_EMAIL=receptionist@example.com
# POSTMARK_MESSAGE_STREAM=outbound
# POSTMARK_API_URL=https://api.postmarkapp.com

# Which channel sendPaymentLink falls back to when the guide doesn't specify
# one: "email" or "sms". Both work once TWILIO_ACCOUNT_SID/TWILIO_FROM_NUMBER
# above and POSTMARK_SERVER_TOKEN/POSTMARK_FROM_EMAIL below are configured.
PAYMENT_LINK_DEFAULT_CHANNEL=email

# --- GuideAnts authoring API (publishing from the admin console) ---
# A GuideAnts user account with the Admin role. This is NOT GUIDEANTS_API_KEY
# (that one is the published guide's key, used on calls). /api/guides requires
# an admin JWT. Leave unset to disable publishing -- preview and bundle
# download still work.
GUIDEANTS_ADMIN_EMAIL=
GUIDEANTS_ADMIN_PASSWORD=
# Must match the guide's name in GuideAnts exactly: import decides
# create-vs-update by matching it, so a mismatch creates a second guide.
GUIDEANTS_GUIDE_NAME=Twilio Demo Agent

# --- Voice latency & call quality (see docs/VOICE_LATENCY_AND_CALL_QUALITY.md) ---
# Pause after the caller stops before the agent takes the turn (seconds).
TURN_RESUME_GRACE_SECONDS=0.6
# Extra wait before taking the turn when the agent asked for a full name and
# the reply so far is a single word. 0 disables.
NAME_EXTRA_WAIT_SECONDS=1.0
# Spoken filler ("Let me check.") only while a tool call runs, after this delay.
FILLER_ONLY_FOR_TOOL_CALLS=true
FILLER_DELAY_SECONDS=0.3
# Soft "working" chime during slow tools. Recommended false: in test calls
# Twilio never fetched the audio and playback stalled (see doc, Known limits).
WORKING_SOUND_ENABLED=false
WORKING_SOUND_TOOLS=listCatalog,checkAvailability,createReservation,sendPaymentLink,findReservations,cancelReservation,listCustomers,createCustomer
# Resend a reply without the chime if Twilio hasn't started playback in N s. 0 disables.
STUCK_AUDIO_RECOVERY_SECONDS=3.0
# ConversationRelay speech-to-text (Deepgram).
STT_SPEECH_MODEL=nova-3-general
STT_LANGUAGE=en-US
# Comma-separated STT hints; leave unset for the built-in list, empty to disable.
# STT_HINTS=
# Hang up after the endCall goodbye finishes playing, plus this margin (s).
END_CALL_AFTER_PLAYBACK_SECONDS=0.4
# Server-side hang-up backup when the guide says goodbye without calling endCall.
AUTO_END_CALL_ENABLED=true
# Ready-made goodbye + hang-up when the caller says they're done after "anything else?".
CANNED_GOODBYE_ENABLED=true
# CANNED_GOODBYE_TEXT=You're welcome! Thanks for calling, and have a great day. Goodbye!
# Business-name pronunciation for the guide's spoken text (word=spoken, comma-separated)
SPOKEN_NAME_ALIASES=Peachtree=Peach tree
# Phrases always sent to TTS whole (never split into sub-word frames)
SPOKEN_JOIN_PHRASES=Peach tree Pedals,Peachtree Pedals
# Refuse createReservation unless the caller said yes to the recap
BOOKING_CONFIRM_GUARD_ENABLED=true
# Tell the guide on the first turn who a known caller is (confirm, don't ask, their name)
KNOWN_CALLER_NOTE_ENABLED=true
# Refuse catalog/availability/booking outside the published business hours
BUSINESS_HOURS_GUARD_ENABLED=true
# Tell the guide the current local date/time and open state on the first turn
NOW_NOTE_ENABLED=true
# Don't answer a bare "hi"/"hello" first turn with a second greeting
IGNORE_FIRST_BARE_GREETING=true
# Catalog names containing these words are listed as accessories, never as rentable items.
ACCESSORY_KEYWORDS=helmet,lock,basket,light,bell,accessory,child seat
# Parallel catalog fetch, catalog/location prefetch at call setup, concurrent
# read-only tool calls. false = old sequential behaviour.
FAST_TOOLS_ENABLED=true
# One throwaway GuideAnts request at startup so the first call isn't a cold start.
GUIDE_WARMUP_ON_STARTUP=true
